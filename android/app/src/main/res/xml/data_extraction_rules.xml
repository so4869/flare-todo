<?xml version="1.0" encoding="utf-8"?>
<!-- 토큰·지문 로그인 정보는 기기 키스토어에 묶여 있어 다른 기기로 옮겨도 쓸 수 없으므로 백업하지 않는다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
